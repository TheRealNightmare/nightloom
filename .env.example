# Nightloom local configuration.
#
#   cp .env.example .env    # then replace every change-me-... value
#
# .env is git-ignored; never commit real secrets. The same file is used for
# Compose interpolation (`--env-file .env`) and for the API container.
# Hostnames are Compose service names because the API runs inside Compose.

# --- API ---------------------------------------------------------------------
# development | test | production
NIGHTLOOM_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
NIGHTLOOM_LOG_LEVEL=INFO
# With NIGHTLOOM_ENV=production the API refuses to start while any secret below
# still contains "change-me".
# Mark the session and CSRF cookies Secure (HTTPS only). Always on in
# production; uncomment when serving a non-production deployment over HTTPS.
# NIGHTLOOM_COOKIE_SECURE=true

# --- Worker ------------------------------------------------------------------
# Worker processes running Shuttle jobs (one job each at a time). 4 suits a
# 16 GB machine running the whole stack.
# NIGHTLOOM_WORKER_CONCURRENCY=4

# Public DNS resolvers the DNS Shuttle asks, as comma-separated IP addresses
# (default: Cloudflare 1.1.1.1 and Quad9 9.9.9.9). Never the host's own
# resolver, and private addresses are refused at startup: an internal
# resolver could leak internal records into a case.
# NIGHTLOOM_DNS_RESOLVERS=1.1.1.1,9.9.9.9

# Reusing recent Shuttle results (see docs/ARCHITECTURE.md#the-result-cache).
# Who shares them: each case on its own (case, the default: one case never
# learns that another looked the same target up), the whole instance
# (instance, for one user or a trusted team), or nobody (off).
# NIGHTLOOM_RESULT_CACHE_SCOPE=case
# Total size kept (least recently used entries go first), and the largest
# single run's results that are kept, in bytes.
# NIGHTLOOM_RESULT_CACHE_MAX_BYTES=536870912
# NIGHTLOOM_RESULT_CACHE_MAX_ENTRY_BYTES=5242880

# --- PostgreSQL --------------------------------------------------------------
# Used by the postgres container on first start (changing them later does not
# alter an existing database; run `make reset` to start over).
POSTGRES_USER=nightloom
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nightloom
# Must match the three values above.
NIGHTLOOM_DATABASE_URL=postgresql+asyncpg://nightloom:change-me-postgres-password@postgres:5432/nightloom

# --- Neo4j -------------------------------------------------------------------
# Password for the built-in `neo4j` user (at least 8 characters). Like the
# PostgreSQL values it only applies when the data volume is first created.
NEO4J_PASSWORD=change-me-neo4j-password
NIGHTLOOM_NEO4J_URI=bolt://neo4j:7687
NIGHTLOOM_NEO4J_USER=neo4j
# Must match NEO4J_PASSWORD.
NIGHTLOOM_NEO4J_PASSWORD=change-me-neo4j-password

# --- Valkey (Redis-compatible queue and cache) -------------------------------
VALKEY_PASSWORD=change-me-valkey-password
# Must contain VALKEY_PASSWORD. Uses the redis:// scheme for client compatibility.
NIGHTLOOM_VALKEY_URL=redis://:change-me-valkey-password@valkey:6379/0

# --- S3-compatible object storage (SeaweedFS by default) ---------------------
NIGHTLOOM_S3_ENDPOINT=http://seaweedfs:8333
# SeaweedFS registers this key pair as its S3 admin identity at startup.
NIGHTLOOM_S3_ACCESS_KEY=change-me-s3-access-key
NIGHTLOOM_S3_SECRET_KEY=change-me-s3-secret-key
# Created automatically when the stack starts.
NIGHTLOOM_S3_BUCKET=nightloom-evidence
NIGHTLOOM_S3_REGION=us-east-1

# --- Production deployment (docs/DEPLOYMENT.md) ------------------------------
# `make secrets` creates .env from this file for a server: random secrets,
# NIGHTLOOM_ENV=production, Secure cookies and the edge settings below.
# With NIGHTLOOM_ENV=production, `make up` and the other targets use
# deploy/compose.prod.yaml too (no ports published except the edge's).
#
# The Nightloom release to run: production pulls
# ghcr.io/therealnightmare/nightloom-backend and -web with this tag instead of
# building images. `make secrets` sets it to this checkout's version; change
# it to upgrade (docs/DEPLOYMENT.md#upgrades).
# NIGHTLOOM_VERSION=0.1.0
#
# Edge proxy in front of the web container: caddy (Compose profile `https`,
# automatic HTTPS on ports 80/443) or cloudflared (profile `tunnel`,
# Cloudflare Tunnel, no open ports). Change both lines together.
# NIGHTLOOM_EDGE=caddy
# COMPOSE_PROFILES=https
#
# Caddy: the public name (its DNS A/AAAA record points at this server) and
# the address the certificate authority sends expiry notices to.
# NIGHTLOOM_DOMAIN=nightloom.example.org
# NIGHTLOOM_ACME_EMAIL=admin@example.org
# Strict-Transport-Security sent by Caddy (default one year, no preload).
# NIGHTLOOM_HSTS=max-age=31536000
#
# Cloudflare Tunnel: the token shown when you create the tunnel in the
# Cloudflare dashboard (Zero Trust > Networks > Tunnels).
# TUNNEL_TOKEN=
#
# 8 GB hosts such as a Raspberry Pi 4B: also use deploy/compose.small.yaml
# (lower Neo4j memory, one worker process).
# NIGHTLOOM_SMALL_HOST=true
#
# Backups (`make backup`): where they go and how many to keep.
# NIGHTLOOM_BACKUP_DIR=backups
# NIGHTLOOM_BACKUP_KEEP=7

# --- Host ports (optional) ---------------------------------------------------
# Ports published on 127.0.0.1. Uncomment and change one if it clashes with a
# service already running on your machine (e.g. a local PostgreSQL on 5432).
# Containers always talk to each other on the default ports above.
# API_HOST_PORT=8000
# WEB_HOST_PORT=8080
# POSTGRES_HOST_PORT=5432
# NEO4J_HTTP_HOST_PORT=7474
# NEO4J_BOLT_HOST_PORT=7687
# VALKEY_HOST_PORT=6379
# S3_HOST_PORT=8333

# --- Compose network (optional) ----------------------------------------------
# The stack's network uses a fixed subnet so the `web` proxy gets a fixed
# address, which is the only one the API trusts for X-Forwarded-For. Change
# these only if the subnet clashes with a network on your machine (keep the web
# address inside the subnet). Other containers get addresses only from the IP
# range, which must lie inside the subnet and must not contain the web address.
# NIGHTLOOM_NETWORK_SUBNET=172.30.0.0/24
# NIGHTLOOM_NETWORK_IP_RANGE=172.30.0.128/25
# NIGHTLOOM_WEB_IP=172.30.0.10
# Fixed addresses of the production edge proxies, the only ones nginx trusts
# for the client's address (also outside the IP range).
# NIGHTLOOM_CADDY_IP=172.30.0.11
# NIGHTLOOM_CLOUDFLARED_IP=172.30.0.12
