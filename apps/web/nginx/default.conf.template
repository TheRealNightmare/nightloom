# Nightloom web: serves the built SPA and proxies /api/ to the API.
#
# Rendered by the image's entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Variables:
#   NIGHTLOOM_API_UPSTREAM  API base URL, default http://api:8000
#   NGINX_LOCAL_RESOLVERS   set by the entrypoint from /etc/resolv.conf
#   NIGHTLOOM_EDGE          the proxy in front of nginx whose client address
#                           it trusts: none (default), caddy or cloudflared;
#                           selects edge/<value>.conf below
#   NIGHTLOOM_CADDY_IP, NIGHTLOOM_CLOUDFLARED_IP  their fixed addresses

# Re-resolve the API's name at request time (Docker's DNS), so nginx starts
# even when the API is not running yet and follows it across restarts.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# Request ID for the API and this access log: the client's X-Request-ID if it
# has the format the API accepts (8-64 of A-Z a-z 0-9 . _ -), else nginx's own
# random $request_id. Both sides then log the same ID, and the API returns it
# in its X-Request-ID response header.
map $http_x_request_id $nightloom_request_id {
    "~^[A-Za-z0-9._-]{8,64}$" $http_x_request_id;
    default $request_id;
}

# The edge proxy in front of nginx (if any): which peer is trusted for the
# client's address (sets $remote_addr, used by the access log and by the
# X-Real-IP / X-Forwarded-For headers for the API) and for the scheme
# ($nightloom_forwarded_proto). An unknown NIGHTLOOM_EDGE value has no file,
# so nginx refuses to start rather than trust the wrong peer.
include /etc/nginx/conf.d/edge/${NIGHTLOOM_EDGE}.conf;

log_format nightloom '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                     'request_id=$nightloom_request_id';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    access_log /var/log/nginx/access.log nightloom;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Container healthcheck; not logged.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API reverse proxy. The API sets its own headers (its docs page needs a
    # different CSP), so the static-site headers below are not added here.
    location /api/ {
        set $api_upstream "${NIGHTLOOM_API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The client address for the API. nginx appends $remote_addr (the peer
        # it sees, or the client the trusted edge proxy reported; see the edge
        # include above) to any X-Forwarded-For it received; uvicorn trusts
        # only this proxy and takes the right-most address that is not a
        # trusted proxy, so a spoofed header cannot win. Keep these in this location: a
        # proxy_set_header in a nested block would replace all of them.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nightloom_forwarded_proto;
        proxy_set_header X-Request-ID $nightloom_request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Content-hashed build output: cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The entry point must always be revalidated so new deployments show up.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Everything else: static files, or the SPA entry point for client routes.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
