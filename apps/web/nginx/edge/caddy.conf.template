# NIGHTLOOM_EDGE=caddy: Caddy (deploy/compose.prod.yaml, profile `https`)
# terminates HTTPS in front of nginx. Only Caddy's fixed address is trusted:
# from it, $remote_addr becomes the right-most X-Forwarded-For address that is
# not Caddy's, which is the client Caddy saw (Caddy itself does not trust a
# client's X-Forwarded-For and appends the peer address). A request from any
# other address keeps its own peer address, whatever headers it sends.
set_real_ip_from ${NIGHTLOOM_CADDY_IP};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Caddy serves only HTTPS (plain HTTP is redirected), and says so in
# X-Forwarded-Proto. Taken only from Caddy's address, and only "https".
map "$realip_remote_addr $http_x_forwarded_proto" $nightloom_forwarded_proto {
    "${NIGHTLOOM_CADDY_IP} https" https;
    default $scheme;
}
