# NIGHTLOOM_EDGE=cloudflared: Cloudflare Tunnel (deploy/compose.prod.yaml,
# profile `tunnel`). Cloudflare's edge sets CF-Connecting-IP to the client's
# address, overwriting any value the client sent, and cloudflared passes it
# on. Only cloudflared's fixed address is trusted: from it, $remote_addr
# becomes CF-Connecting-IP; from any other address the header is ignored.
set_real_ip_from ${NIGHTLOOM_CLOUDFLARED_IP};
real_ip_header CF-Connecting-IP;

# Cloudflare's edge sets X-Forwarded-Proto to the scheme the client used.
# Taken only from cloudflared's address, and only "https".
map "$realip_remote_addr $http_x_forwarded_proto" $nightloom_forwarded_proto {
    "${NIGHTLOOM_CLOUDFLARED_IP} https" https;
    default $scheme;
}
